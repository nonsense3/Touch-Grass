# ==============================================================================
# TOUCH GRASS // NVIDIA NIM + GEMMA 4B OPEN-WEIGHT AI CONFIGURATION
# ==============================================================================
# NVIDIA NIM (NVIDIA Inference Microservices) delivers ultra-low-latency 
# inference on NVIDIA Tensor Core GPUs for open models like Google Gemma 4.
# Get your API key at: https://build.nvidia.com

# Your NVIDIA NIM API Key (starts with nvapi-...)
VITE_GEMMA_API_KEY=nvapi-your-key-here

# Provider setting: "nvidia-nim" (default), "google", "openai-compatible", "ollama"
VITE_GEMMA_PROVIDER=nvidia-nim

# Target Model Name on NVIDIA NIM:
# - "google/gemma-4-26b-a4b-it" (Gemma 4 A4B MoE with 4B active parameters on NIM)
# - "google/gemma-4-e4b-it"     (Gemma 4 E4B on-device / edge variant)
# - "google/gemma-4b"           (Alias)
# - "google/gemma-2-9b-it"       (Gemma 2 9B IT)
# - "google/gemma-2-2b-it"       (Gemma 2 2B IT)
VITE_GEMMA_MODEL=google/gemma-4-26b-a4b-it

# NVIDIA NIM Integration Endpoint:
VITE_GEMMA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
